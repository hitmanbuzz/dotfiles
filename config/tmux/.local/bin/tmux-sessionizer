#!/usr/bin/env bash

# Select directory using fzf
selected=$(find ~/ -mindepth 1 -maxdepth 2 -type d 2>/dev/null | fzf --prompt="Select directory: ")

if [[ -z $selected ]]; then
    exit 0
fi

# Prompt for session name with explicit tty redirection
echo -n "Enter session name: " > /dev/tty
read session_name < /dev/tty

if [[ -z $session_name ]]; then
    echo "No session name provided. Exiting." > /dev/tty
    exit 0
fi

# Sanitize session name
session_name=$(echo "$session_name" | tr . _)

tmux_running=$(pgrep tmux)

# If tmux isn't running, create new session and attach
if [[ -z $TMUX ]] && [[ -z $tmux_running ]]; then
    tmux new-session -s "$session_name" -c "$selected"
    exit 0
fi

# Check if session already exists
if ! tmux has-session -t="$session_name" 2> /dev/null; then
    tmux new-session -d -s "$session_name" -c "$selected"
fi

# Switch or attach to session
if [[ -z $TMUX ]]; then
    tmux attach-session -t "$session_name"
else
    tmux switch-client -t "$session_name"
fi

