#!/usr/bin/env bash

# 1. Select directory using fzf
if [[ $# -eq 1 ]]; then
    selected=$1
else
    # -maxdepth 3: Looks 3 folders deep (adjust this number if you need more depth)
    # -mindepth 1: Skips the root folder itself (e.g., just "/home/user")
    # You can add more paths after ~/Projects if you want
    selected=$(find ~/ ~/Projects -mindepth 1 -maxdepth 3 -type d 2> /dev/null | fzf)
fi

if [[ -z $selected ]]; then
    exit 0
fi

# Ensure we have an absolute path (handles if you pass '.' or a relative path as $1)
selected=$(realpath "$selected")

# 2. Extract a unique session name based on the path
# Remove the home directory prefix (if present) to keep the name shorter
relative_path="${selected/#$HOME/}"
# Remove leading slash if it exists
relative_path="${relative_path#/}"

# If the path is empty (e.g., you selected the home directory itself), name it "home"
if [[ -z "$relative_path" ]]; then
    session_name="home"
else
    # Replace slashes with hyphens, and dots/colons with underscores 
    # (tmux doesn't like dots or colons in session names)
    session_name=$(echo "$relative_path" | tr '.:' '_' | tr '/' '-')
fi

# 3. Check if session exists
tmux_running=$(pgrep tmux)

# If tmux isn't running at all, create new session and attach
if [[ -z $TMUX ]] && [[ -z $tmux_running ]]; then
    tmux -u new-session -s "$session_name" -c "$selected"
    exit 0
fi

# If session doesn't exist, create it (detached)
if ! tmux has-session -t="$session_name" 2> /dev/null; then
    tmux -u new-session -ds "$session_name" -c "$selected"
fi

# 4. Switch to the session
if [[ -z $TMUX ]]; then
    tmux -u attach-session -t "$session_name"
else
    tmux -u switch-client -t "$session_name"
fi
